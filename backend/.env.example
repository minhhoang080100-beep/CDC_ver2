# MongoDB connection string (Atlas or local)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
DB_NAME=cdc_database

# JWT — generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-strong-secret-key-here

# Cloudinary (optional — required for image/document uploads)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Sentry (optional — error monitoring)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Token expiry (optional — defaults shown)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REFRESH_TOKEN_EXPIRE_DAYS=7
